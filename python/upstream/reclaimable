def _same_node(a, b) -> bool:
    return (a.st_dev, a.st_ino, stat.S_IFMT(a.st_mode)) == (
        b.st_dev,
        b.st_ino,
        stat.S_IFMT(b.st_mode),
    )


def _require_node(parent_fd: int, name: str, expected) -> None:
    current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if not _same_node(current, expected):
        raise OSError(f"replaced filesystem entry: {name}")


@contextlib.contextmanager
def _directory_at(parent_fd: int, name: str, expected=None):
    if expected is None:
        expected = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if stat.S_ISLNK(expected.st_mode):
        raise OSError(f"symlink in path: {name}")
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
    try:
        if not _same_node(os.fstat(fd), expected):
            raise OSError(f"replaced directory: {name}")
        _require_node(parent_fd, name, expected)
        yield fd
        _require_node(parent_fd, name, expected)
    finally:
        os.close(fd)


@contextlib.contextmanager
def _directory(path: Path, create: bool = False):
    """Open all path components without following links, optionally creating them."""
    path = Path(os.path.abspath(Path(path).expanduser()))
    with contextlib.ExitStack() as stack:
        fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        stack.callback(os.close, fd)
        for name in path.parts[1:]:
            if create:
                try:
                    os.mkdir(name, mode=0o700, dir_fd=fd)
                except FileExistsError:
                    pass
            fd = stack.enter_context(_directory_at(fd, name))
        yield fd


def _tree_entries(
    fd: int, dev: int, rel: Path = Path(), depth: int = 0, deadline=None, prune=()
):
    """Yield checked descriptor-relative entries; never follow directory symlinks."""
    if deadline is None:
        deadline = time.monotonic() + WALK_LIMIT_S
    if depth > 200 or time.monotonic() > deadline:
        raise OSError("tree traversal depth/time limit exceeded")
    for entry in list(os.scandir(fd)):
        if time.monotonic() > deadline:
            raise OSError("tree traversal timed out")
        st = entry.stat(follow_symlinks=False)
        name = entry.name
        _require_node(fd, name, st)
        yield fd, name, st, rel / name
        _require_node(fd, name, st)
        if depth == 0 and fold(name) in prune:
            continue
        if stat.S_ISDIR(st.st_mode) and st.st_dev == dev:
            with _directory_at(fd, name, st) as child_fd:
                yield from _tree_entries(
                    child_fd, dev, rel / name, depth + 1, deadline, prune
                )


@contextlib.contextmanager
def _regular_file(parent_fd: int, name: str, expected):
    if not stat.S_ISREG(expected.st_mode):
        raise OSError(f"not a regular file: {name}")
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent_fd)
    try:
        before = os.fstat(fd)
        if not _same_node(before, expected):
            raise OSError(f"replaced file: {name}")
        yield fd
        after = os.fstat(fd)
        if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        ):
            raise OSError(f"file changed while reading: {name}")
        _require_node(parent_fd, name, expected)
    finally:
        os.close(fd)


def _refuse_extended_data(fd: int) -> None:
    """A byte-only verified move cannot authorise losing extended payloads."""
    if hasattr(os, "listxattr"):
        names = os.listxattr(fd)
    elif sys.platform == "darwin":
        query = ctypes.CDLL(None, use_errno=True).flistxattr
        query.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int]
        query.restype = ctypes.c_ssize_t
        size = query(fd, None, 0, 0)
        if size < 0 or size > 1 << 20:
            raise OSError("cannot inspect extended attributes")
        buffer = ctypes.create_string_buffer(size)
        count = query(fd, buffer, size, 0)
        if count < 0 or count > size:
            raise OSError("cannot inspect extended attributes")
        names = [
            n.decode("utf-8", "replace") for n in buffer.raw[:count].split(b"\0") if n
        ]
    else:
        raise OSError("extended attribute inspection unavailable")
    # System-managed provenance is attached automatically, including to new
    # temporary files. All application attributes and resource forks veto moves.
    if any(name != "com.apple.provenance" for name in names):
        raise OSError("extended data cannot be preserved and verified; source kept")


@contextlib.contextmanager
def _relative_directory(root_fd: int, relative: Path, expected: dict):
    with contextlib.ExitStack() as stack:
        fd = root_fd
        current = Path()
        for name in relative.parts:
            current /= name
            fd = stack.enter_context(_directory_at(fd, name, expected[current]))
        yield fd


def _content_tree(root: Path, destination: Path | None = None) -> dict[str, str]:
    """Hash, optionally snapshot, through descriptors; destination must be new."""
    out = {}
    destination_ids = {}
    directory_metadata = {}
    with contextlib.ExitStack() as stack:
        root_fd = stack.enter_context(_directory(root))
        _refuse_extended_data(root_fd)
        dev = os.fstat(root_fd).st_dev
        dest_root = None
        if destination is not None:
            parent_fd = stack.enter_context(_directory(destination.parent, create=True))
            os.mkdir(destination.name, mode=0o700, dir_fd=parent_fd)
            dest_root = stack.enter_context(_directory_at(parent_fd, destination.name))
        for parent_fd, name, st, rel in _tree_entries(root_fd, dev):
            if st.st_dev != dev:
                raise OSError(f"another filesystem at {rel}")
            if stat.S_ISDIR(st.st_mode):
                with _directory_at(parent_fd, name, st) as fd:
                    _refuse_extended_data(fd)
                if dest_root is not None:
                    with _relative_directory(
                        dest_root, rel.parent, destination_ids
                    ) as dest_fd:
                        os.mkdir(name, mode=0o700, dir_fd=dest_fd)
                        destination_ids[rel] = os.stat(
                            name, dir_fd=dest_fd, follow_symlinks=False
                        )
                        directory_metadata[rel] = st
                continue
            if name == ".DS_Store":
                continue
            if stat.S_ISLNK(st.st_mode):
                if sys.platform == "darwin":
                    fd = os.open(
                        name,
                        os.O_RDONLY | os.O_SYMLINK | os.O_NONBLOCK,
                        dir_fd=parent_fd,
                    )
                    try:
                        if not _same_node(os.fstat(fd), st):
                            raise OSError("symlink replaced")
                        _refuse_extended_data(fd)
                    finally:
                        os.close(fd)
                elif hasattr(os, "listxattr"):
                    names = os.listxattr(
                        f"/proc/self/fd/{parent_fd}/{name}", follow_symlinks=False
                    )
                    if names:
                        raise OSError("extended data on symlink; source kept")
                else:
                    raise OSError("symlink attribute inspection unavailable")
                link = os.readlink(name, dir_fd=parent_fd)
                _require_node(parent_fd, name, st)
                out[str(rel)] = "link:" + link
                if dest_root is not None:
                    with _relative_directory(
                        dest_root, rel.parent, destination_ids
                    ) as dest_fd:
                        os.symlink(link, name, dir_fd=dest_fd)
                continue
            h = hashlib.sha256()
            with _regular_file(parent_fd, name, st) as source_fd:
                _refuse_extended_data(source_fd)
                with contextlib.ExitStack() as file_stack:
                    target = None
                    if dest_root is not None:
                        dest_fd = file_stack.enter_context(
                            _relative_directory(dest_root, rel.parent, destination_ids)
                        )
                        target_fd = os.open(
                            name,
                            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                            0o600,
                            dir_fd=dest_fd,
                        )
                        target = file_stack.enter_context(os.fdopen(target_fd, "wb"))
                        target_stat = os.fstat(target_fd)
                    for chunk in iter(lambda: os.read(source_fd, 1 << 20), b""):
                        h.update(chunk)
                        if target is not None:
                            target.write(chunk)
                    if target is not None:
                        target.flush()
                        os.fchmod(target_fd, stat.S_IMODE(st.st_mode) & 0o777)
                        os.utime(target_fd, ns=(st.st_atime_ns, st.st_mtime_ns))
                        _require_node(dest_fd, name, target_stat)
            out[str(rel)] = h.hexdigest()
        # Set directory metadata after populating descendants, deepest first.
        for relative, st in reversed(list(directory_metadata.items())):
            with _relative_directory(dest_root, relative, destination_ids) as fd:
                os.fchmod(fd, stat.S_IMODE(st.st_mode) & 0o777)
                os.utime(fd, ns=(st.st_atime_ns, st.st_mtime_ns))
    return out


def file_hashes(root: Path) -> dict[str, str]:
    return _content_tree(root)


def remote_run(
    cfg_cmd: list[str], host: str, script: str, **kw
) -> subprocess.CompletedProcess:
    cmd = [a.replace("{host}", host).replace("{script}", script) for a in cfg_cmd]
    kw.setdefault("stdin", subprocess.DEVNULL)
    return subprocess.run(cmd, **kw)


def _remote_archive(mode, destination):
    """Self-contained remote receiver/hash program; never follows path symlinks."""
    import contextlib
    import hashlib
    import json
    import os
    import stat
    import sys
    import tarfile
    from pathlib import Path

    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW

    def same(a, b):
        return (a.st_dev, a.st_ino, stat.S_IFMT(a.st_mode)) == (
            b.st_dev,
            b.st_ino,
            stat.S_IFMT(b.st_mode),
        )

    def require(parent, name, expected):
        current = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if not same(current, expected):
            raise OSError(f"entry replaced: {name}")

    @contextlib.contextmanager
    def directory_at(parent, name, expected=None, create=False):
        if create:
            try:
                os.mkdir(name, 0o700, dir_fd=parent)
            except FileExistsError:
                pass
        before = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if not stat.S_ISDIR(before.st_mode) or (
            expected is not None and not same(before, expected)
        ):
            raise OSError(f"not the expected directory: {name}")
        fd = os.open(name, flags, dir_fd=parent)
        try:
            if not same(os.fstat(fd), before):
                raise OSError(f"directory replaced: {name}")
            require(parent, name, before)
            yield fd
            require(parent, name, before)
        finally:
            os.close(fd)

    @contextlib.contextmanager
    def directory(path, create=False, exclusive=False):
        path = Path(os.path.abspath(Path(path).expanduser()))
        with contextlib.ExitStack() as stack:
            fd = os.open("/", flags)
            stack.callback(os.close, fd)
            for index, name in enumerate(path.parts[1:]):
                last = index == len(path.parts) - 2
                if exclusive and last:
                    os.mkdir(name, 0o700, dir_fd=fd)
                fd = stack.enter_context(directory_at(fd, name, create=create))
            if exclusive and path == Path("/"):
                raise OSError("destination already exists")
            yield fd

    def inventory(fd, prefix, dev, out):
        for entry in list(os.scandir(fd)):
            if entry.name == ".DS_Store":
                continue
            expected = entry.stat(follow_symlinks=False)
            relative = prefix + entry.name
            if stat.S_ISDIR(expected.st_mode):
                if expected.st_dev != dev:
                    raise OSError(f"filesystem boundary: {relative}")
                with directory_at(fd, entry.name, expected) as child:
                    inventory(child, relative + "/", dev, out)
            elif stat.S_ISLNK(expected.st_mode):
                out[relative] = "link:" + os.readlink(entry.name, dir_fd=fd)
                require(fd, entry.name, expected)
            elif stat.S_ISREG(expected.st_mode):
                opened = os.open(
                    entry.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd
                )
                with os.fdopen(opened, "rb") as source:
                    before = os.fstat(source.fileno())
                    if not same(before, expected):
                        raise OSError(f"file replaced: {relative}")
                    digest = hashlib.sha256()
                    for chunk in iter(lambda: source.read(1 << 20), b""):
                        digest.update(chunk)
                    after = os.fstat(source.fileno())
                    if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
                        after.st_size,
                        after.st_mtime_ns,
                        after.st_ctime_ns,
                    ):
                        raise OSError(f"file changed: {relative}")
                require(fd, entry.name, expected)
                out[relative] = digest.hexdigest()
            else:
                raise OSError(f"unsupported file type: {relative}")

    if mode == "hash":
        hashes = {}
        with directory(destination) as fd:
            inventory(fd, "", os.fstat(fd).st_dev, hashes)
        print(json.dumps(hashes), flush=True)
        return
    if mode != "receive":
        raise ValueError("invalid transfer operation")
    destination_ids = {}

    @contextlib.contextmanager
    def extraction_directory(parent, name, relative):
        expected = destination_ids.get(relative)
        with directory_at(
            parent, name, expected=expected, create=expected is None
        ) as fd:
            if expected is None:
                destination_ids[relative] = os.fstat(fd)
            yield fd

    with directory(destination, create=True, exclusive=True) as root:
        with tarfile.open(fileobj=sys.stdin.buffer, mode="r|") as archive:
            for member in archive:
                parts = member.name.rstrip("/").split("/")
                if not parts or any(p in ("", ".", "..") for p in parts):
                    raise ValueError("unsafe archive member")
                if not (member.isdir() or member.isfile() or member.issym()):
                    raise ValueError("unsupported archive member")
                with contextlib.ExitStack() as stack:
                    parent = root
                    for index, name in enumerate(parts[:-1]):
                        parent = stack.enter_context(
                            extraction_directory(
                                parent, name, tuple(parts[: index + 1])
                            )
                        )
                    name = parts[-1]
                    if member.isdir():
                        with extraction_directory(parent, name, tuple(parts)):
                            pass
                    elif member.issym():
                        os.symlink(member.linkname, name, dir_fd=parent)
                    else:
                        fd = os.open(
                            name,
                            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                            0o600,
                            dir_fd=parent,
                        )
                        with os.fdopen(fd, "wb") as target:
                            original = os.fstat(target.fileno())
                            source = archive.extractfile(member)
                            if source is None:
                                raise ValueError("missing archive file data")
                            remaining = member.size
                            with source:
                                while remaining:
                                    chunk = source.read(min(1 << 20, remaining))
                                    if not chunk:
                                        raise ValueError("truncated archive file")
                                    target.write(chunk)
                                    remaining -= len(chunk)
                            target.flush()
                            os.fchmod(target.fileno(), member.mode & 0o777)
                            os.utime(target.fileno(), (member.mtime, member.mtime))
                        require(parent, name, original)


def _remote_script(mode: str, path: str) -> str:
    source = inspect.getsource(_remote_archive)
    source += f"\n_remote_archive({mode!r}, {path!r})\n"
    return "python3 -c " + shlex_quote(source)


def remote_copy(
    stage: Path, dest: str, host: str, cfg_cmd: list[str]
) -> tuple[bool, str]:
    """Transfer a private snapshot to an exclusively created remote directory."""
    try:
        with tempfile.TemporaryFile() as stream:
            # The source is a private snapshot, never the mutable marked tree.
            with tarfile.open(fileobj=stream, mode="w") as archive:
                for child in sorted(stage.iterdir()):
                    archive.add(child, arcname=child.name, recursive=True)
            stream.seek(0)
            result = remote_run(
                cfg_cmd,
                host,
                _remote_script("receive", dest),
                stdin=stream,
                capture_output=True,
                text=True,
                timeout=WALK_LIMIT_S,
            )
        if result.returncode != 0:
            return False, f"remote transfer failed: {result.stderr.strip()[:160]}"
        return True, dest
    except (OSError, ValueError, tarfile.TarError, subprocess.TimeoutExpired) as e:
        return False, f"remote transfer failed: {e}"


def remote_hashes(host: str, path: str, cfg_cmd: list[str]) -> dict[str, str] | None:
    try:
        res = remote_run(
            cfg_cmd,
            host,
            _remote_script("hash", path),
            capture_output=True,
            text=True,
            timeout=WALK_LIMIT_S,
        )
        if res.returncode != 0:
            return None
        out = json.loads(res.stdout)
        if not isinstance(out, dict) or not all(
            isinstance(k, str) and isinstance(v, str) for k, v in out.items()
        ):
            return None
        return out
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def shlex_quote(s: str) -> str:
    return shlex.quote(s)


def move_destination(dest_root: str, folder: Path) -> tuple[str | None, str]:
    host, sep, root = dest_root.partition(":")
    if not sep or "/" in host:
        host, root = None, dest_root
    rel = f"{hostname()}{folder}"
    return host, str(
        Path(root).expanduser() / rel
    ) if not host else f"{root.rstrip('/')}/{rel}"


def move_and_verify(
    folder: Path,
    dest_root: str,
    remote_cmd: list[str] | None = None,
    src: dict[str, str] | None = None,
) -> tuple[bool, str]:
    remote_cmd = remote_cmd or DEFAULT_REMOTE_COMMAND
    host, dest = move_destination(dest_root, folder)
    try:
        if src is None:
            src = file_hashes(folder)
        src = {k: v for k, v in src.items() if k != MARKER}
        # Transport only a private, descriptor-read snapshot. A mutable source
        # must never be handed to a path-following recursive copy program.
        with tempfile.TemporaryDirectory(prefix="reclaimable-") as temporary:
            stage = Path(temporary).resolve() / "snapshot"
            snapshot = _content_tree(folder, stage)
            snapshot.pop(MARKER, None)
            staged = file_hashes(stage)
            staged.pop(MARKER, None)
            if snapshot != src or staged != src:
                return False, "hash mismatch in snapshot; source changed or copy failed"
            if host:
                ok, detail = remote_copy(stage, dest, host, remote_cmd)
                if not ok:
                    return False, detail
                got = remote_hashes(host, dest, remote_cmd)
                if got is None:
                    return False, "remote hash failed"
            else:
                _content_tree(stage, Path(dest))
                got = file_hashes(Path(dest))
        got.pop(MARKER, None)
        if got != src:
            missing = sorted(set(src) - set(got))[:3]
            changed = sorted(k for k in set(src) & set(got) if src[k] != got[k])[:3]
            return (
                False,
                f"hash mismatch at {dest} (missing {missing}, changed {changed})",
            )
        current = file_hashes(folder)
        current.pop(MARKER, None)
        if current != src:
            return False, "source changed while it was being copied"
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        return False, f"copy/verification failed: {e}"
    return True, f"{host + ':' if host else ''}{dest}"


def rmtree_same_dev(path: Path, expected=None) -> list[Path]:
    """Delete `path` without crossing into other filesystems. Returns the directories
    left behind because they are mount points (or could not be removed)."""
    left: list[Path] = []

    def clear(fd: int, d: Path, dev: int, depth: int = 0) -> bool:
        ok = True
        if depth > 200:
            left.append(d)
            return False
        try:
            entries = list(os.scandir(fd))
        except OSError:
            left.append(d)
            return False
        for e in entries:
            child = d / e.name
            try:
                st = e.stat(follow_symlinks=False)
                _require_node(fd, e.name, st)
                if stat.S_ISDIR(st.st_mode):
                    if st.st_dev != dev:
                        left.append(child)
                        ok = False
                    else:
                        with _directory_at(fd, e.name, st) as child_fd:
                            complete = clear(child_fd, child, dev, depth + 1)
                        if complete:
                            _require_node(fd, e.name, st)
                            os.rmdir(e.name, dir_fd=fd)
                        else:
                            ok = False
                else:
                    _require_node(fd, e.name, st)
                    os.unlink(e.name, dir_fd=fd)
            except OSError:
                left.append(child)
                ok = False
        return ok

    with _directory(path.parent) as parent_fd:
        st = os.stat(path.name, dir_fd=parent_fd, follow_symlinks=False)
        if expected is not None and not _same_node(st, expected):
            raise OSError("removal root replaced")
        with _directory_at(parent_fd, path.name, st) as root_fd:
            complete = clear(root_fd, path, st.st_dev)
        if complete:
            _require_node(parent_fd, path.name, st)
            os.rmdir(path.name, dir_fd=parent_fd)
    return left


def entry_for(folder: Path, reg: dict) -> dict:
    return reg["markers"].setdefault(str(folder), {"registered": now()})


def remove_folder(
    v: Verdict, armed: bool, cfg: Config, reg: dict, floor_pressure: bool = False
) -> tuple[bool, str]:
    """Final re-checks, then move/delete. Returns (done, detail).

    Everything that could have changed since evaluation is re-checked under the
    marker lock (the same lock `hold` takes) immediately before the source is
    renamed away, including after a long verified copy. Unless the folder was
    chosen for free-space pressure (`floor_pressure`), its TTL/grace clock is
    recomputed from the fresh marker mtime, job close time and session state and
    it must still be expired."""
    m = v.marker
    if m is None:
        return False, "invalid or missing marker"
    if not armed:
        return False, "dry-run"
    if os.path.ismount(v.folder):
        return False, "folder is a mount point"
    try:
        ident = v.folder.lstat()
    except OSError as e:
        return False, f"folder unreadable: {e.strerror}"
    if (
        v.directory_identity is None
        or (ident.st_dev, ident.st_ino) != v.directory_identity
    ):
        return False, "folder replaced since evaluation"

    def recheck(src_hashes: dict[str, str] | None = None) -> str | None:
        try:
            fresh = read_marker(v.folder)
        except (OSError, ValueError) as e:
            return f"marker changed: {e}"
        if fresh.mtime != m.mtime or fresh.holds:
            return "marker touched or held since evaluation"
        if deny_reason(v.folder, cfg):
            return "refused by deny-list"
        try:
            now_stat = v.folder.lstat()
        except OSError as e:
            return f"folder unreadable: {e.strerror}"
        if (now_stat.st_dev, now_stat.st_ino) != (ident.st_dev, ident.st_ino):
            return "folder replaced since evaluation"
        hold = holder_hold(fresh, cfg)
        if hold:
            return f"held: {hold}"
        busy = open_files(v.folder)
        if busy:
            return busy
        # Job state may have changed (reopened, keep/hold label, helper failing):
        # ask again, bypassing the cache.
        closed_at = None
        if fresh.job:
            closed, closed_at, detail = job_closed(fresh.job, cfg, reg, fresh=True)
            if not closed:
                return f"job {fresh.job} {detail if closed is False else 'state unknown: ' + detail}"
        if fresh.session:
            entry = entry_for(v.folder, reg)
            reason = session_problem(fresh, cfg, entry, closed_at)
            if reason:
                return reason
        if not floor_pressure:
            start = fresh.mtime
            if fresh.job:
                start = max(start, closed_at or 0)
            if fresh.session:
                start = max(start, entry_for(v.folder, reg).get("session_exit_seen", 0))
            try:
                ttl_s = fresh.ttl_seconds
            except ValueError as e:
                return f"bad marker: {e}"
            if now() - start < ttl_s:
                return (
                    f"no longer expired (clock restarted {human_age(now() - start)} ago, "
                    f"ttl {human_age(ttl_s)})"
                )
        # Repeat the worktree checks: work may have been added since evaluation
        # (or during a long copy) that the original verdict never saw.
        w = walk(v.folder, cfg, check_names=True)
        reason, repo = tree_problem(v.folder, fresh, cfg, w)
        if reason:
            return reason
        if repo != v.repo:
            return "repository type changed since evaluation"
        if src_hashes is not None:
            try:
                current = file_hashes(v.folder)
            except OSError as e:
                return f"source unreadable during verification: {e}"
            current.pop(MARKER, None)
            if current != src_hashes:
                return "source changed while it was being copied"
        return None

    with hold_lock():
        problem = recheck()
    if problem:
        return False, problem
    dest_detail = ""
    src_hashes = None
    if v.action == "move":
        try:
            src_hashes = file_hashes(v.folder)
        except OSError as e:
            return False, f"source unreadable: {e}"
        src_hashes.pop(MARKER, None)
        ok, detail = move_and_verify(
            v.folder, v.dest, cfg.remote_command, src=src_hashes
        )
        if not ok:
            return False, f"kept source: {detail}"
        dest_detail = f" -> {detail}"
    with hold_lock():
        # A hold, lease, reader or write may have appeared during the copy.
        problem = recheck(src_hashes)
        if problem:
            return False, f"kept source{dest_detail}: {problem}"
        common = None
        if v.repo == "git-linked":
            res = run(
                ["git", "-C", str(v.folder), "rev-parse", "--git-common-dir"],
                timeout=30,
            )
            if res.returncode == 0:
                common = (v.folder / res.stdout.strip()).resolve()
        if v.repo == "jj-secondary":
            res = run(
                [
                    "jj",
                    "-R",
                    str(v.folder),
                    "--ignore-working-copy",
                    "workspace",
                    "forget",
                ],
                timeout=60,
            )
            if res.returncode != 0:
                return False, f"jj workspace forget failed: {res.stderr.strip()[:100]}"
        trash = v.folder.with_name(
            f".{v.folder.name}.reclaimable-trash-{secrets.token_hex(12)}"
        )
        try:
            with _directory(v.folder.parent) as parent_fd:
                _require_node(parent_fd, v.folder.name, ident)
                try:
                    os.stat(trash.name, dir_fd=parent_fd, follow_symlinks=False)
                except FileNotFoundError:
                    pass
                else:
                    return False, "quarantine destination exists"
                os.rename(
                    v.folder.name,
                    trash.name,
                    src_dir_fd=parent_fd,
                    dst_dir_fd=parent_fd,
                )
                moved = os.stat(trash.name, dir_fd=parent_fd, follow_symlinks=False)
                if not _same_node(moved, ident):
                    try:
                        os.stat(v.folder.name, dir_fd=parent_fd, follow_symlinks=False)
                    except FileNotFoundError:
                        os.rename(
                            trash.name,
                            v.folder.name,
                            src_dir_fd=parent_fd,
                            dst_dir_fd=parent_fd,
                        )
                    return False, "folder replaced before rename; nothing deleted"
        except OSError as e:
            return False, f"rename refused: {e}"
    try:
        left = rmtree_same_dev(trash, expected=ident)
    except OSError as e:
        return False, f"kept renamed source at {trash}: {e}"
    if common:
        run(["git", "--git-dir", str(common), "worktree", "prune"], timeout=60)
    reg["markers"].pop(str(v.folder), None)
    if left:
        dest_detail += f" (left {trash} holding {len(left)} other-filesystem dirs)"
    return True, dest_detail


# --- sweep -------------------------------------------------------------------------------


def free_bytes(path: Path) -> int:
    return shutil.disk_usage(path).free


def armed_state() -> tuple[bool, str]:
    if not ARMED_FILE.exists():
        return False, "unarmed"
    try:
        at = float(json.loads(ARMED_FILE.read_text())["armed_at"])
    except (OSError, ValueError, KeyError, TypeError):
        return False, f"unreadable {ARMED_FILE}"
    if now() - at < ARM_GRACE_S:
        return False, f"armed {human_age(now() - at)} ago; dry-run until 24h"
    return (
        True,
        f"armed since {time.strftime('%Y-%m-%d', time.localtime(at))} {clock(at)}",
    )


def volume_limits(folder: Path, cfg: Config) -> tuple[int, int] | None:
    """(floor, target) for the volume holding `folder`, or None when it has no floor."""
    try:
        dev = folder.stat().st_dev
        home_dev = HOME.stat().st_dev
    except OSError:
        return None
    mount = folder
    while not os.path.ismount(mount) and mount != mount.parent:
        mount = mount.parent
    floor = next(
        (v for k, v in cfg.volume_floors.items() if path_key(k) == path_key(mount)),
        cfg.floor if dev == home_dev else None,
    )
    if floor is None:
        return None
    return floor, (cfg.target if dev == home_dev else floor + TARGET_MARGIN)


def plan(
    verdicts: list[Verdict], cfg: Config, *, estimate: bool = True
) -> list[tuple[Verdict, str]]:
    """Expired + safe always; then, per volume under its floor, safe ones LRU-first until target."""
    chosen = [(v, "ttl expired") for v in verdicts if v.safe and v.expired]
    picked = {id(v) for v, _ in chosen}
    home_dev = HOME.stat().st_dev
    by_dev: dict[int, list[Verdict]] = {}
    for v in verdicts:
        with contextlib.suppress(OSError):
            by_dev.setdefault(v.folder.stat().st_dev, []).append(v)
    for dev, group in by_dev.items():
        mount = group[0].folder
        while not os.path.ismount(mount) and mount != mount.parent:
            mount = mount.parent
        floor = next(
            (v for k, v in cfg.volume_floors.items() if path_key(k) == path_key(mount)),
            cfg.floor if dev == home_dev else None,
        )
        if floor is None:
            continue
        target = cfg.target if dev == home_dev else floor + TARGET_MARGIN
        free = free_bytes(group[0].folder)
        if estimate:
            free += sum(v.size or 0 for v, _ in chosen if v.folder.stat().st_dev == dev)
        if free >= floor:
            continue
        for v in sorted(group, key=lambda x: x.last_used):
            if estimate and free >= target:
                break
            if v.safe and id(v) not in picked and v.size:
                chosen.append(
                    (
                        v,
                        f"low space ({human_bytes(free)} free < floor {human_bytes(floor)}), LRU",
                    )
                )
                picked.add(id(v))
                if estimate:
                    free += v.size
    return chosen


def sweep(args, cfg: Config) -> int:
    if args.floor is not None:
        cfg.floor = args.floor
        cfg.target = max(cfg.target, cfg.floor)
    if args.target is not None:
        cfg.target = max(args.target, cfg.floor)
    if args.dry_run:
        armed, mode = False, "dry-run (forced)"
    elif args.armed:
        armed = ARMED_FILE.exists()
        mode = (
            "armed (manual)"
            if armed
            else "dry-run: --armed needs `reclaimable arm` first"
        )
    else:
        armed, mode = armed_state()
        mode = mode if armed else f"dry-run ({mode})"
    with state_lock():
        reg = load_registry()
        folders = discover(cfg, reg, force_scan=args.scan)
        verdicts = [evaluate(f, cfg, reg) for f in folders]
        # Dry-run estimates are bounded by sizes. Real sweeps retain later LRU
        # candidates until a fresh free-space measurement reaches the target.
        actions = plan(verdicts, cfg, estimate=not armed)
        done = []
        acted = set()
        for v, why in actions:
            acted.add(id(v))
            m = v.marker
            verb = "move" if v.action == "move" else "delete"
            pressure = why.startswith("low space")
            if armed and pressure:
                # Allocation estimates can overstate reclaim (shared extents,
                # hardlinks); only measured free space ends pressure removal.
                lim = volume_limits(v.folder, cfg)
                if lim:
                    real = free_bytes(v.folder)
                    if max(real, 0) >= lim[1]:
                        line = (
                            f"skip {v.folder}: free space target reached "
                            f"({human_bytes(real)} free >= {human_bytes(lim[1])})"
                        )
                        log(line)
                        say(line)
                        done.append(
                            {
                                **v.row(),
                                "why": why,
                                "done": False,
                                "detail": "target reached",
                            }
                        )
                        continue
            ok, detail = remove_folder(v, armed, cfg, reg, floor_pressure=pressure)
            line = (
                f"{'' if armed else '[dry-run] '}{verb if ok else ('would ' + verb if not armed else verb + ' SKIPPED')} "
                f"{v.folder} ({human_bytes(v.size)}) owner={m.owner} kind={m.effective_kind} reason={why}"
                f"{detail if ok else ('' if detail == 'dry-run' else ': ' + detail)}"
            )
            log(line)
            say(line)
            done.append({**v.row(), "why": why, "done": ok, "detail": detail})
        write_export_list(reg, cfg)
        save_registry(reg)
        summary = {
            "at": now(),
            "host": hostname(),
            "mode": mode,
            "armed": armed,
            "markers": len(verdicts),
            "free": free_bytes(HOME),
            "floor": cfg.floor,
            "target": cfg.target,
            "actions": done,
            "blocked": [v.row() for v in verdicts if not v.safe],
            "kept": [v.row() for v in verdicts if id(v) not in acted],
            "scan_complete": reg.get("last_scan_complete"),
        }
        write_json(LAST_SWEEP, summary)
    freed = sum(a["size"] or 0 for a in done if a["done"])
    would = sum(a["size"] or 0 for a in done)
    tail = (
        f"sweep {mode}: {len(verdicts)} markers, {len(done)} actions, "
        f"{'freed ' + human_bytes(freed) if armed else 'would free ' + human_bytes(would)}, "
        f"{len(summary['kept'])} kept, free {human_bytes(summary['free'])} (floor {human_bytes(cfg.floor)})"
    )
    log(tail)
    say(tail)
    if args.verbose:
        for v in verdicts:
            if id(v) not in acted:
                say(f"  keep {v.folder}: {v.reason}")
    return 0


# --- commands -------------------------------------------------------------------------------


def resolve_folder(raw: str) -> Path:
    p = expand(raw)
    if fold(p.name) == fold(MARKER):
        p = p.parent
    return p


def cmd_mark(args, cfg: Config) -> int:
    folder = resolve_folder(args.path)
    deny = deny_reason(folder, cfg)
    if deny:
        print(
            f"reclaimable: refusing to mark {folder}: {deny}",
            file=sys.stderr,
            flush=True,
        )
        return 2
    if args.ttl:
        parse_ttl(args.ttl)
    folder.mkdir(parents=True, exist_ok=True)
    try:
        m = read_marker(folder)
    except FileNotFoundError:
        m = Marker(folder=folder, owner=args.owner)
    except ValueError as e:
        print(
            f"reclaimable: replacing invalid marker ({e})", file=sys.stderr, flush=True
        )
        m = Marker(folder=folder, owner=args.owner)
    m.owner = args.owner
    for key in ("ttl", "kind", "job", "session", "move_to"):
        value = getattr(args, key)
        if value is not None:
            setattr(m, key, value or None)
    if args.regen is not None:
        m.regenerate = args.regen
    if not m.regenerate:
        print(
            "reclaimable: --regen is required for a new marker",
            file=sys.stderr,
            flush=True,
        )
        return 2
    write_marker(m)
    register(folder)
    say(
        f"marked {folder} owner={m.owner} kind={m.effective_kind} ttl={m.ttl or DEFAULT_TTL[m.effective_kind]}"
    )
    return 0


def cmd_touch(args, cfg: Config) -> int:
    rc = 0
    for raw in args.paths:
        marker = resolve_folder(raw) / MARKER
        if not marker.is_file():
            print(
                f"reclaimable: no marker in {marker.parent}",
                file=sys.stderr,
                flush=True,
            )
            rc = 1
            continue
        os.utime(marker)
    return rc


def cmd_hold(args, cfg: Config, release: bool = False) -> int:
    folder = resolve_folder(args.path)
    with hold_lock():
        try:
            m = read_marker(folder)
        except (OSError, ValueError) as e:
            print(f"reclaimable: {folder}: {e}", file=sys.stderr, flush=True)
            return 1
        sub = expand(args.subpath) if args.subpath else None

        def same_subpath(a, b):
            if a is None or b is None:
                return a is b
            return isinstance(a, str) and path_key(a) == path_key(b)

        if release:
            before = len(m.holds)
            m.holds = [
                h
                for h in m.holds
                if not (
                    h.get("job") == args.job
                    and (sub is None or same_subpath(h.get("path"), str(sub)))
                )
            ]
            if len(m.holds) == before:
                print(
                    f"reclaimable: {args.job} holds nothing in {folder}",
                    file=sys.stderr,
                    flush=True,
                )
                return 1
        else:
            hold = {"job": args.job, "at": now()}
            if sub:
                hold["path"] = str(sub)
            m.holds = [
                h
                for h in m.holds
                if not (
                    h.get("job") == args.job
                    and same_subpath(h.get("path"), hold.get("path"))
                )
            ]
            m.holds.append(hold)
        write_marker(m)
    say(
        f"{'released' if release else 'held'} {folder} for {args.job} ({len(m.holds)} holds)"
    )
    return 0


def cmd_ls(args, cfg: Config) -> int:
    roots = [expand(r) for r in args.roots] or None
    with state_lock():
        reg = load_registry()
        folders = discover(cfg, reg, force_scan=args.scan, roots=roots)
        verdicts = [evaluate(f, cfg, reg, deep=not args.quick) for f in folders]
        save_registry(reg)
        write_export_list(reg, cfg)
    rows = [v.row() for v in verdicts]
    if args.json:
        print(json.dumps(rows, indent=2), flush=True)
        return 0
    if not rows:
        say("no .reclaimable markers")
        return 0
    for r in sorted(rows, key=lambda r: r["last_used"] or 0):
        state = (
            "ELIGIBLE"
            if r["safe"] and r["expired"]
            else ("safe" if r["safe"] else "kept")
        )
        path = str(r["path"]).replace(str(HOME), "~", 1)
        say(
            f"{state:8} {human_bytes(r['size']):>9}  {human_age(r['age_s'] or 0):>6} / {r['ttl'] or '?':<4} "
            f"{(r['owner'] or '?')[:14]:<14} {(r['kind'] or '?'):<8} {path}  ({r['reason']})"
        )
    return 0


def cmd_status(args, cfg: Config) -> int:
    armed, mode = armed_state()
    last = load_json(LAST_SWEEP, None)
    say(
        f"host {hostname()}  {mode}  free {human_bytes(free_bytes(HOME))}  floor {human_bytes(cfg.floor)}  target {human_bytes(cfg.target)}"
    )
    reg = load_json(REGISTRY, {"markers": {}})
    say(
        f"registered markers: {len(reg.get('markers', {}))}  last scan: "
        f"{human_age(now() - reg['last_scan']) + ' ago' if reg.get('last_scan') else 'never'}"
        f"{'' if reg.get('last_scan_complete', True) else ' (depth/time-limited; marked folders are always registered)'}"
    )
    if last:
        say(
            f"last sweep {human_age(now() - last['at'])} ago ({last['mode']}): {last['markers']} markers, "
            f"{len(last['actions'])} actions, {len(last.get('kept', last['blocked']))} kept"
        )
    else:
        say("no sweep yet")
    if LOG_FILE.exists():
        say(f"--- {str(LOG_FILE).replace(str(HOME), '~')} (last {args.lines})")
        for line in LOG_FILE.read_text().splitlines()[-args.lines :]:
            say(line)
    return 0


def cmd_arm(args, cfg: Config) -> int:
    if args.off:
        ARMED_FILE.unlink(missing_ok=True)
        log("disarmed")
        say("disarmed: sweeps are dry-run")
        return 0
    if ARMED_FILE.exists():
        say(armed_state()[1])
        return 0
    write_json(ARMED_FILE, {"armed_at": now(), "host": hostname()})
    log("armed (first 24h stay dry-run)")
    say("armed; scheduled sweeps stay dry-run for the first 24h")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="reclaimable",
        description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Config: ~/.config/reclaimable/config.toml (see README)",
    )
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    s = sub.add_parser("mark", help="create/update a folder's .reclaimable marker")
    s.add_argument("path")
    s.add_argument(
        "-o", "--owner", required=True, help="tool or job that owns the folder"
    )
    s.add_argument(
        "-t",
        "--ttl",
        help="e.g. 24h, 3d (default by kind: "
        + ", ".join(f"{k} {v}" for k, v in DEFAULT_TTL.items())
        + ")",
    )
    s.add_argument("-r", "--regen", help="one line: how the folder comes back")
    s.add_argument("-k", "--kind", choices=KINDS)
    s.add_argument("-j", "--job", help="job issue number (#N) for job-tied data")
    s.add_argument(
        "-s",
        "--session",
        help="id of the session that owns the data (a pid, or text matched against the process list)",
    )
    s.add_argument(
        "-m",
        "--move-to",
        dest="move_to",
        help="move here (path or host:path) instead of deleting",
    )

    s = sub.add_parser("touch", help="mark folders used now")
    s.add_argument("paths", nargs="+")

    for name, text in (
        ("hold", "declare a job is reading the folder (never removed while held)"),
        ("release", "drop a job's hold"),
    ):
        s = sub.add_parser(name, help=text)
        s.add_argument("path")
        s.add_argument("job")
        s.add_argument(
            "-p", "--path", dest="subpath", help="specific path inside the folder"
        )

    s = sub.add_parser("ls", help="list markers with age, size, TTL and eligibility")
    s.add_argument("roots", nargs="*")
    s.add_argument("-j", "--json", action="store_true")
    s.add_argument(
        "-q",
        "--quick",
        action="store_true",
        help="skip size/lsof/lease/worktree checks",
    )
    s.add_argument(
        "-S", "--scan", action="store_true", help="rescan roots for markers first"
    )

    s = sub.add_parser("sweep", help="the janitor (dry-run unless this host is armed)")
    g = s.add_mutually_exclusive_group()
    g.add_argument("-n", "--dry-run", action="store_true", help="never remove anything")
    g.add_argument(
        "-A",
        "--armed",
        action="store_true",
        help="act now (host must be armed; skips the 24h wait)",
    )
    s.add_argument(
        "-f",
        "--floor",
        type=parse_size,
        help="free-space floor (default: config, else 30GB)",
    )
    s.add_argument(
        "-t",
        "--target",
        type=parse_size,
        help="free space to reach once under the floor",
    )
    s.add_argument(
        "-S", "--scan", action="store_true", help="full marker rescan (otherwise daily)"
    )
    s.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="also list kept markers with reasons",
    )

    s = sub.add_parser("status", help="armed state, free space, last sweep, log tail")
    s.add_argument("-l", "--lines", type=int, default=15)

    s = sub.add_parser("arm", help="arm this host (scheduled sweeps act after 24h)")
    s.add_argument("-x", "--off", action="store_true", help="disarm")
    return p


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    cfg = load_config()
    try:
        if args.cmd == "mark":
            return cmd_mark(args, cfg)
        if args.cmd == "touch":
            return cmd_touch(args, cfg)
        if args.cmd in ("hold", "release"):
            return cmd_hold(args, cfg, release=args.cmd == "release")
        if args.cmd == "ls":
            return cmd_ls(args, cfg)
        if args.cmd == "sweep":
            return sweep(args, cfg)
        if args.cmd == "status":
            return cmd_status(args, cfg)
        if args.cmd == "arm":
            return cmd_arm(args, cfg)
    except ValueError as e:
        print(f"reclaimable: {e}", file=sys.stderr, flush=True)
        return 2
    return 1


if __name__ == "__main__":
    sys.exit(main())
